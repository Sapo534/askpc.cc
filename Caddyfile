# Matrix Homeserver Subdomain
matrix.askpc.cc {
    reverse_proxy conduit:6167
}

# www -> apex
www.askpc.cc {
    redir https://askpc.cc{uri} permanent
}

# Main Website + Matrix Delegation
askpc.cc {
    handle /.well-known/matrix/client {
        header Access-Control-Allow-Origin "*"
        header Content-Type application/json
        respond `{"m.homeserver":{"base_url":"https://matrix.askpc.cc"}}`
    }

    handle /.well-known/matrix/server {
        header Access-Control-Allow-Origin "*"
        header Content-Type application/json
        respond `{"m.server":"matrix.askpc.cc:443"}`
    }

    handle {
        reverse_proxy web:8000
    }
}
